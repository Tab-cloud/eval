# PostgreSQL
DATABASE_URL=postgresql://eval:change-me@127.0.0.1:5432/eval
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=15
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Public HTTPS origin used to construct OAuth callbacks behind Nginx.
APP_ORIGIN=https://eval.zailink.space
# Only releases owned by this tenant are exposed through public download and updater APIs.
EVAL_PUBLIC_RELEASE_TENANT_SLUG=connecting-hangzhou
# Minisign/Tauri updater public key used to verify every uploaded .sig file.
# Accepts the full .pub content, its base64-wrapped form, or the raw RW... key line.
EVAL_UPDATER_PUBLIC_KEY=replace-with-tauri-minisign-public-key
# Tenant whose settings drive the public Google and GitHub login entrypoints.
EVAL_IDENTITY_TENANT_SLUG=connecting-hangzhou
# Only published blog posts owned by this tenant are exposed publicly.
EVAL_PUBLIC_CONTENT_TENANT_SLUG=connecting-hangzhou

# Chinese login: Alibaba Cloud SMS. The sign and template must already be
# approved in the Alibaba Cloud console. Keep credentials server-side only.
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-in-deployment-environment
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-in-deployment-environment
ALIYUN_SMS_SIGN_NAME=replace-with-approved-sign
ALIYUN_SMS_TEMPLATE_CODE=replace-with-approved-template-code
ALIYUN_SMS_TEMPLATE_CODE_KEY=code
AUTH_SMS_CODE_PEPPER=replace-with-at-least-32-random-characters

# English login: Google OpenID Connect web application credentials.
GOOGLE_OAUTH_CLIENT_ID=replace-in-deployment-environment
GOOGLE_OAUTH_CLIENT_SECRET=replace-in-deployment-environment
# Optional: restrict sign-in to one Google Workspace domain.
# GOOGLE_ALLOWED_HOSTED_DOMAIN=example.com

# Chinese and English login: GitHub OAuth App credentials. The OAuth App only
# needs user:email to obtain a verified identity for account creation or binding.
GITHUB_OAUTH_CLIENT_ID=replace-in-deployment-environment
GITHUB_OAUTH_CLIENT_SECRET=replace-in-deployment-environment

# ECS persistent volume. Use an absolute path in production.
ARTIFACT_STORAGE_PATH=./data/artifacts

# Local development only. Never expose the seeded 123456 accounts in production.
EVAL_ENABLE_SEEDED_ACCOUNTS=true
EVAL_ENABLE_PASSWORD_LOGIN=false
